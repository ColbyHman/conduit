# Conduit Environment Variables
# Copy this file to .env and fill in your values

# Required: LLM API Key (OpenAI, Anthropic, or compatible)
LLM_API_KEY=your_llm_api_key_here

# Optional: Custom LLM endpoint (for Ollama, vLLM, LM Studio, etc.)
# LLM_ENDPOINT=http://host.docker.internal:11434

# Optional: LLM Model (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Optional: LLM Provider (openai, anthropic, ollama, openai-compatible)
LLM_PROVIDER=openai

# Required for Whisper Worker: Whisper API URL
# For local development with host-native Whisper (Mac Metal, Linux CUDA):
WHISPER_URL=http://host.docker.internal:9000

# Optional: Whisper model (tiny, base, small, medium, large-v3)
WHISPER_MODEL=medium

# Optional: Database URL (default works with docker-compose)
# DATABASE_URL=postgres://conduit:conduit_dev@localhost:5432/conduit?sslmode=disable

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Pretty log output (true/false)
LOG_PRETTY=true